# Fail closed: unknown root files stay local; never force-add private data.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/index.html
!/genealogy.html
!/sources.html
!/atlas.css
!/genealogy.css
!/personal-data.css
!/atlas-config.js
!/atlas-api.js
!/personal-data.js
!/atlas.js
!/character-manager.js
!/formation-manager.js
!/territory-editor.js
!/territory-edits.js
!/place-manager.js
!/place-periods.js
!/genealogy-client.js
!/genealogy.js
!/genealogy-data.js
!/geo-data.js
!/history-data.js
!/history-reconstruction.source.js
!/map-data.js
!/review-data.js
!/territory-corrections.json
!/curated-evidence.json
!/biography-normalization.json
!/atlas_server.py
!/place_search.py
!/place_period_store.py
!/biography_search.py
!/genealogy_search.py
!/genealogy_store.py
!/build_territories.py
!/audit_territories.py
!/vendor/
/vendor/*
!/vendor/leaflet.js
!/vendor/leaflet.css
!/vendor/LEAFLET-LICENSE.txt
!/vendor/polygon-clipping.umd.min.js
!/vendor/POLYGON-CLIPPING-LICENSE.txt
!/vendor/OPENCC-LICENSE.txt
!/vendor/images/
/vendor/images/*
!/vendor/images/layers.png
!/vendor/images/layers-2x.png
!/vendor/images/marker-icon.png
!/vendor/images/marker-icon-2x.png
!/vendor/images/marker-shadow.png
!/scripts/
/scripts/*
!/scripts/build_pages.py
!/scripts/prepare_publication.py
!/scripts/fetch_genealogy_index.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
# Tests must contain synthetic fixtures, never private saved user data.
!/tests/
**/__pycache__/
**/*.py[cod]
**/.env*
**/*token*
**/*secret*
**/*.log
